# Copy to .env (chmod 600). Never commit .env.

# Required: the Fire TV's IP. The helper controls this TV over ADB and answers no other client.
TV_IP=

# Optional: an address of this machine to listen on (default 0.0.0.0 = all) and the port (default 8788).
BIND=
PORT=8788

# Optional: Sports Remote, for Orbit's game line (default http://127.0.0.1:8787, same machine).
SPORTS_REMOTE_URL=
# Sports Remote's household PIN, if it uses PIN sign-in.
SPORTS_REMOTE_PIN=
# Local teams as league:ABBR, only used when Sports Remote doesn't report your market (e.g. nfl:NYG,mlb:NYM).
LOCAL_TEAMS=
# Time zone for "Tonight" / "Today" on the game line (default: this machine's).
TZ=

# Optional: HOMEWATCH=0 skips pushing homewatch.sh to the TV (Android TV / Google TV, where Orbit owns Home itself).
HOMEWATCH=1

# Optional: PlayStation 4 wake before switching to its HDMI port (Remote Play pairing; see README).
PS4_HDMI=3
PS4_HOST=
PS4_CREDENTIAL=
